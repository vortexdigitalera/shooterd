<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- Allow querying Shizuku package -->
        <package android:name="moe.shizuku.privileged.api"/>
        <!-- Allow starting Shizuku service -->
        <intent>
            <action android:name="moe.shizuku.manager.intent.ACTION_START_SHIZUKU"/>
        </intent>
    </queries>

    <!-- Shizuku permission for API access -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23"/>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/module_label"
        android:hasCode="true"
        android:theme="@style/Theme.BootloaderSpoofer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/module_label"/>

        <activity-alias
            android:name=".LauncherAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/module_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!--
            Stays enabled even when the launcher icon is hidden. CATEGORY_INFO is
            not displayed by launchers but is resolved by PackageManager.getLaunchIntentForPackage,
            so LSPosed Manager can still open the app via its "Launch" button.
        -->
        <activity-alias
            android:name=".LaunchInfoAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/module_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.INFO"/>
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/about_title"
            android:parentActivityName=".MainActivity"/>

        <activity
            android:name=".AdvancedActivity"
            android:exported="false"
            android:label="@string/advanced_title"
            android:parentActivityName=".AboutActivity"/>

        <activity
            android:name=".EditKeyboxActivity"
            android:exported="false"
            android:label="@string/edit_keybox_title"
            android:parentActivityName=".AdvancedActivity"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".UnlockHelperActivity"
            android:exported="false"
            android:label="@string/unlock_helper_title"
            android:parentActivityName=".MainActivity"/>

        <activity
            android:name=".SystemTweaksActivity"
            android:exported="false"
            android:label="@string/system_tweaks_title"
            android:parentActivityName=".MainActivity"/>

        <activity
            android:name=".ModuleLoaderActivity"
            android:exported="false"
            android:label="@string/module_loader_title"
            android:parentActivityName=".MainActivity"/>

        <activity
            android:name=".DebugInfoActivity"
            android:exported="false"
            android:label="@string/debug_info_title"
            android:parentActivityName=".MainActivity"/>

        <activity
            android:name=".MiniProotActivity"
            android:exported="false"
            android:label="@string/miniproot_title"
            android:parentActivityName=".MainActivity"/>

        <!-- Shizuku provider for receiving binder from Shizuku server -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"/>
    </application>
</manifest>
